<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Chỉnh sửa thông tin hoa"
        android:textColor="@color/text_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Tên hoa -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên hoa:"
        android:textColor="@color/text_title"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtFlowerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:autofillHints=""
        android:hint="Nhập tên hoa"
        android:inputType="textCapSentences"
        android:textSize="15sp" />

    <!-- Giá hoa -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Giá (VND):"
        android:textColor="@color/text_title"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtFlowerPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:autofillHints=""
        android:hint="Nhập giá (kiểu số)"
        android:inputType="numberDecimal"
        android:textSize="15sp" />

    <!-- Mô tả hoa -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mô tả của hoa:"
        android:textColor="@color/text_title"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtFlowerDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:autofillHints=""
        android:gravity="top|start"
        android:hint="Nhập mô tả của hoa"
        android:inputType="textMultiLine"
        android:lines="3"
        android:textSize="15sp" />

    <!-- Các nút thao tác -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnViewDetail"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Chi tiết"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnCancel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="@color/text_sub" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_cyan_blue"
            android:text="Lưu"
            android:textAllCaps="false"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>